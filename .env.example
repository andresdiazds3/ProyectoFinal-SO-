# =============================================================================
# Proyecto final – Administración de Sistemas Operativos (UAO)
# Archivo     : .env.example
# Fase        : 0 – Preparación
# Responsable : Persona 1
# Propósito   : Plantilla de variables de entorno. Se copia a .env (que NO se
#               sube a Git): cp .env.example .env
# =============================================================================

# Puertos del computador (host). Si alguno está ocupado o reservado (en Windows
# pasa con frecuencia), cambia SOLO el número de aquí; no toques el compose.
HOST_PORT_NGINX=8080
HOST_PORT_PROMETHEUS=9090
HOST_PORT_GRAFANA=3001
HOST_PORT_CADVISOR=8082

# Credenciales de Grafana (solo para laboratorio local).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
