{
  "uid": "proyecto-final",
  "title": "Proyecto Final - Infraestructura",
  "tags": ["proyecto-final", "nginx", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "row", "title": "Estado general", "collapsed": false, "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "panels": []},
    {"id": 2, "title": "Targets en UP (esperado: 6)", "description": "Cuenta los targets que Prometheus puede leer. Con todo sano valen 6.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(up)", "legendFormat": "UP", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 5}, {"color": "green", "value": 6}]}}, "overrides": []}, "options": {}},
    {"id": 3, "title": "Peticiones/s totales (backends)", "description": "Suma de lo que atienden los 3 backends.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 4, "y": 1, "w": 5, "h": 4}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(rate(flask_http_request_total[30s]))", "legendFormat": "req/s", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}, "overrides": []}, "options": {}},
    {"id": 4, "title": "Errores 5xx por segundo", "description": "Debe ser 0. Si un backend se cae, Nginx reintenta con otro y el usuario no ve errores.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 9, "y": 1, "w": 5, "h": 4}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(rate(flask_http_request_total{status=~\"5..\"}[30s])) or vector(0)", "legendFormat": "5xx/s", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]}}, "overrides": []}, "options": {}},
    {"id": 5, "title": "Conexiones activas en Nginx", "description": "Conexiones abiertas ahora mismo en el proxy.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 14, "y": 1, "w": 5, "h": 4}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "nginx_connections_active", "legendFormat": "activas", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {}},
    {"id": 6, "title": "Backends en UP", "description": "Cuántos de los 3 backends responden. Bájalo apagando uno: docker compose stop backend1.", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 19, "y": 1, "w": 5, "h": 4}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum(up{job=\"backends\"})", "legendFormat": "backends", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 2}, {"color": "green", "value": 3}]}}, "overrides": []}, "options": {}},
    {"id": 7, "type": "row", "title": "Backends (Node.js)", "collapsed": false, "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "panels": []},
    {"id": 8, "title": "Peticiones por segundo por backend", "description": "Si el balanceo funciona, las tres líneas se parecen.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (backend) (rate(flask_http_request_total[30s]))", "legendFormat": "{{backend}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 9, "title": "Reparto de peticiones entre backends", "description": "Porcentaje de peticiones que atendió cada backend en el rango de tiempo elegido.", "type": "piechart", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 6, "w": 6, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (backend) (increase(flask_http_request_total[$__range]))", "legendFormat": "{{backend}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["percent"]}, "pieType": "pie", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 10, "title": "Peticiones por endpoint", "description": "Qué rutas se están usando: index (/), slow, headers.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 18, "y": 6, "w": 6, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (endpoint) (rate(flask_http_request_duration_seconds_count[30s]))", "legendFormat": "{{endpoint}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 11, "title": "Latencia p95 por backend", "description": "El 95 % de las peticiones tarda menos que este valor.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(flask_http_request_duration_seconds_bucket[30s])))", "legendFormat": "{{backend}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 12, "title": "Latencia p50 (mediana) por backend", "description": "La mitad de las peticiones tarda menos que este valor.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le, backend) (rate(flask_http_request_duration_seconds_bucket[30s])))", "legendFormat": "{{backend}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 13, "type": "row", "title": "Nginx", "collapsed": false, "gridPos": {"x": 0, "y": 22, "w": 24, "h": 1}, "panels": []},
    {"id": 14, "title": "Peticiones por segundo en Nginx", "description": "Debe ser parecido a la suma de los backends (más ~0,2 req/s del propio exporter).", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 23, "w": 8, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "rate(nginx_http_requests_total[30s])", "legendFormat": "nginx", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 15, "title": "Conexiones activas", "description": "Estado de las conexiones del proxy.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 8, "y": 23, "w": 8, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "nginx_connections_active", "legendFormat": "activas", "range": true, "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "nginx_connections_reading", "legendFormat": "leyendo", "range": true, "refId": "B"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "nginx_connections_writing", "legendFormat": "escribiendo", "range": true, "refId": "C"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "nginx_connections_waiting", "legendFormat": "en espera", "range": true, "refId": "D"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 16, "title": "Conexiones aceptadas vs manejadas", "description": "Si las dos líneas coinciden, Nginx no está rechazando conexiones.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 16, "y": 23, "w": 8, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "rate(nginx_connections_accepted[30s])", "legendFormat": "aceptadas", "range": true, "refId": "A"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "rate(nginx_connections_handled[30s])", "legendFormat": "manejadas", "range": true, "refId": "B"}], "fieldConfig": {"defaults": {"unit": "cps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 17, "type": "row", "title": "Recursos por contenedor (cAdvisor)", "collapsed": false, "gridPos": {"x": 0, "y": 31, "w": 24, "h": 1}, "panels": []},
    {"id": 18, "title": "CPU por contenedor", "description": "Núcleos de CPU en uso (1 = un núcleo completo).", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[30s]))", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 19, "title": "Memoria por contenedor", "description": "Memoria realmente en uso (working set).", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 20, "title": "Red recibida por contenedor", "description": "", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[30s]))", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 21, "title": "Red enviada por contenedor", "description": "", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[30s]))", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 22, "title": "Disco: escritura por contenedor", "description": "Puede ser 0 si el contenedor no escribe a disco.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 48, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name!=\"\"}[30s]))", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 23, "title": "Disco: lectura por contenedor", "description": "Puede ser 0 si el contenedor no lee de disco.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 48, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name!=\"\"}[30s]))", "legendFormat": "{{name}}", "range": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ]
}
