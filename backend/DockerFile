# Imagen base: Node 20 sobre Alpine Linux (muy pequeña, ~50 MB).
FROM node:20-alpine

# Carpeta de trabajo dentro del contenedor. Los siguientes comandos se ejecutan aquí.
WORKDIR /app

# Se copian PRIMERO solo los archivos de dependencias. Docker guarda cada paso en
# caché: si no cambian las dependencias, no las reinstala y el build es más rápido.
COPY package*.json ./

# "npm ci" instala exactamente las versiones del package-lock.json.
# "--omit=dev" ignora dependencias de desarrollo (no las necesitamos).
RUN npm ci --omit=dev

# Ahora sí se copia el código de la API.
COPY app.js ./

# Variables de entorno por defecto.
ENV NODE_ENV=production \
    PORT=3000

# Documenta que la app escucha en el puerto 3000 (no lo publica al host).
EXPOSE 3000

# Seguridad: ejecutar como el usuario "node" y no como root.
USER node

# Cada 10 s Docker consulta /health. Si falla 3 veces seguidas, marca el
# contenedor como "unhealthy". Nginx espera a que esté "healthy" para arrancar.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/health || exit 1

# Comando que se ejecuta al iniciar el contenedor.
CMD ["node", "app.js"]